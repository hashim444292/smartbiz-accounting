# Database Configuration (PostgreSQL / Supabase / Neon / Local Docker)
DATABASE_URL="postgresql://postgres.xxxx:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:your_password@db.xxxx.supabase.co:5432/postgres"

# Authentication & Session Security
JWT_SECRET="super-secret-accounting-jwt-key-change-in-production-2026"

# AI & OCR Service (OpenAI API for OCR / Whisper / Text extraction)
OPENAI_API_KEY=""

# Optional Google Gemini API key if using Gemini provider
GEMINI_API_KEY=""

# Application metadata
NEXT_PUBLIC_APP_NAME="SmartBiz Accounting & AI Ledger"
NEXT_PUBLIC_DEFAULT_CURRENCY="PKR"
