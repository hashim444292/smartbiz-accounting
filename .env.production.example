# ==============================================================================
# SmartBiz Accounting - Production Environment Variables Template
# Copy this file to .env.production on your VPS: cp .env.production.example .env.production
# DO NOT commit real secrets to Git.
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3000
HOSTNAME="0.0.0.0"

# Public Domain URL (used for absolute redirects, metadata, and webhooks)
NEXT_PUBLIC_APP_URL="https://myaccounts360.com"

# PostgreSQL Connection String (Connecting to existing VPS PostgreSQL via host gateway)
# Syntax: postgresql://[USER]:[PASSWORD]@host.docker.internal:5432/[DATABASE]?schema=public
# If your existing PostgreSQL runs directly on the VPS host, use host.docker.internal or 172.17.0.1
DATABASE_URL="postgresql://smartbiz_user:YOUR_SECURE_PASSWORD_HERE@host.docker.internal:5432/smartbiz_db?schema=public"
DIRECT_URL="postgresql://smartbiz_user:YOUR_SECURE_PASSWORD_HERE@host.docker.internal:5432/smartbiz_db?schema=public"

# Authentication & Session Security (Generate with: openssl rand -base64 48)
JWT_SECRET="GENERATE_A_RANDOM_64_CHAR_SECRET_HERE"

# Optional: AI & Smart OCR Keys (Leave blank or fill with your provider keys)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
